# ==============================================================================
# DuoNest — Couples Finance & Budgeting Environment Configuration
# ==============================================================================

# Supabase Configuration (Recommended Primary Database - Server-side Private)
# Create a project at https://supabase.com and copy credentials from Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Authentication & Session Security (Required)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_string_key_for_production

# Google Cloud Service Account Credentials (For Headless Database)
# Create at https://console.cloud.google.com/iam-admin/serviceaccounts
# Grant Editor access to the spreadsheet and Drive folder
GOOGLE_SERVICE_ACCOUNT_EMAIL=duonest-service@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Sheets Spreadsheet ID (Extracted from Sheet URL)
# Example: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Drive Receipts Folder ID (For Receipt Image Storage)
# Example: https://drive.google.com/drive/folders/1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=your_google_drive_folder_id_here

# Optional Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Google Single Sign-On (SSO) & Couple Access Control (Optional)
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.vercel.app/api/auth/sso/callback
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=babi-savingsapp.vercel.app/api/auth/sso/callback

# Whitelist authorized emails for Partner A and Partner B
PARTNER_A_EMAIL=hanzangelobernabe212@gmail.com
PARTNER_B_EMAIL=causon.julia@gmail.com

